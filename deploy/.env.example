# StreamTube — production environment (deploy/compose.yaml). Copy to deploy/.env on the VPS and fill in.
# deploy/.env is git-ignored: it holds every secret of the platform. Never set MSW_ENABLED here.
# Keys and choices: home-search-production/TD-08..TD-11 and docs/deploy/runbook.md.

# --- Edge and images ---
DOMAIN=streamtube.example.com
# GitHub owner of the GHCR images (ghcr.io/<owner>/streamtube-api and -web) and the tag to run
# (the deploy workflow sets the commit SHA).
GHCR_OWNER=your-github-user
IMAGE_TAG=latest

# --- Frontend (web) ---
# iron-session cookie secret, at least 32 characters (openssl rand -base64 48).
SESSION_PASSWORD=change-me-to-a-random-string-of-at-least-32-characters
# The frontend reaches the API on the internal network; fixed in compose.yaml as http://api:3000.
API_URL=http://api:3000

# --- API / worker / migrate ---
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://streamtube.example.com
APP_URL=https://streamtube.example.com
SWAGGER_ENABLED=false
# Fixed IP of `web` in compose.yaml — the only address whose X-Forwarded-For the API trusts.
TRUST_PROXY=172.31.0.10

# PostgreSQL (service `db` of compose.yaml; the same values create the database).
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=change-me
DB_NAME=streamtube

# JWT (openssl rand -base64 48 for each secret).
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Transactional SMTP provider (home-search-production/TD-09). User and password go together.
# MAIL_SECURE=true for implicit TLS (port 465); false for STARTTLS (port 587).
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=change-me
MAIL_PASSWORD=change-me
MAIL_SECURE=false
MAIL_FROM="StreamTube <noreply@streamtube.example.com>"

# AWS S3 (home-search-production/TD-09, Revisions — AWS S3). The bucket needs CORS for FRONTEND_URL,
# the public-read policy on thumbnails/* only and the abort-incomplete-multipart lifecycle rule
# (docs/deploy/runbook.md). On AWS both endpoints are the regional endpoint.
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_PUBLIC_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=streamtube-videos
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_FORCE_PATH_STYLE=false

# Upload / playback limits (defaults shown).
UPLOAD_PART_SIZE=67108864
UPLOAD_MAX_BYTES=10737418240
UPLOAD_URL_TTL=3600
UPLOAD_TTL=86400
PLAYBACK_URL_TTL=43200
THUMBNAIL_MAX_BYTES=5242880

# Job queue (pg-boss on the same PostgreSQL).
QUEUE_SCHEMA=pgboss
QUEUE_SUPERVISE=true

# Backups (deploy/backup.sh): bucket prefix and days to keep.
BACKUP_PREFIX=backups
BACKUP_RETENTION_DAYS=14
