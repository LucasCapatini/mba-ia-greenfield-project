FROM node:22.16.0-slim

WORKDIR /home/node/app

# Pontos de montagem dos volumes nomeados (compose.yaml), criados já com dono `node`:
# um volume novo copia conteúdo e propriedade deste caminho da imagem na primeira montagem,
# então `npm install` e o dev server (que escreve em .next) não falham com EACCES.
RUN mkdir -p /home/node/app/node_modules /home/node/app/.next && chown -R node:node /home/node/app

USER node

CMD [ "tail", "-f", "/dev/null" ] 