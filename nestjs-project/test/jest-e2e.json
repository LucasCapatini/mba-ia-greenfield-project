{
  "moduleFileExtensions": [
    "js",
    "cjs",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "setupFiles": [
    "dotenv/config",
    "<rootDir>/../src/test/jest-env.cjs"
  ],
  "testTimeout": 90000,
  "moduleNameMapper": {
    "^pg-boss$": "<rootDir>/../src/test/pg-boss.cjs"
  },
  "maxWorkers": 1
}
