# Application
NODE_ENV=development
PORT=3000

# URLs
# APP_URL = URL pública da própria API; FRONTEND_URL = destino dos links de e-mail (obrigatória, Joi uri)
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="StreamTube <noreply@streamtube.com>"
# Produção — provedor SMTP transacional (home-search-production/TD-09). Usuário e senha andam juntos
# (a API não sobe com só um deles); sem eles o transporte é o do Mailpit. MAIL_SECURE=true = TLS
# implícito (porta 465); com STARTTLS (porta 587) deixe false.
# MAIL_USER=
# MAIL_PASSWORD=
# MAIL_SECURE=false

# Swagger UI em /api/docs — só em dev; mantenha false em produção.
SWAGGER_ENABLED=false

# Object storage S3-compatível (RustFS em dev — phase-03-videos/TD-01, TD-02)
# S3_ENDPOINT = host interno (nome do serviço Compose) usado pela API/worker e pelo storage-init.
# S3_PUBLIC_ENDPOINT = host alcançável pelo navegador; só assina URLs pré-assinadas (o host faz parte da assinatura).
# As mesmas credenciais configuram o RustFS (RUSTFS_ACCESS_KEY/RUSTFS_SECRET_KEY) via compose.yaml.
S3_ENDPOINT=http://rustfs:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=streamtube
S3_SECRET_KEY=streamtube-secret
S3_BUCKET=streamtube-videos
S3_FORCE_PATH_STYLE=true

# Upload / playback (bytes e segundos — TD-03, TD-09, TD-12)
# UPLOAD_PART_SIZE mínimo 5 MiB (limite S3); os testes usam 5 MiB para provar multipart sem 10 GiB.
UPLOAD_PART_SIZE=67108864
UPLOAD_MAX_BYTES=10737418240
UPLOAD_URL_TTL=3600
UPLOAD_TTL=86400
PLAYBACK_URL_TTL=43200
# Thumbnail customizada (Fase 04, TD-04): teto do arquivo enviado em PUT /videos/{id}/thumbnail
THUMBNAIL_MAX_BYTES=5242880

# Fila pg-boss sobre o PostgreSQL (TD-04): schema próprio e supervisão (worker: true; API pode usar false)
QUEUE_SCHEMA=pgboss
QUEUE_SUPERVISE=true

# IP(s) do proxy confiável (watch-page/TD-03): o IP fixo do next-frontend na rede streamtube
# (next-frontend/compose.yaml). Só dele a API aceita X-Forwarded-For para identificar o visitante
# (throttler e contagem de visualizações). Ausente → trust proxy desligado. Lista separada por vírgula.
TRUST_PROXY=172.30.0.10
